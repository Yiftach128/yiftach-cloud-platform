# Copy to .env and adjust. All values are optional — the server falls back to the
# defaults shown here.

# Server bind address
PORT=3000
HOST=127.0.0.1

# Docker daemon endpoint, docker CLI style (defaults to tcp://127.0.0.1:2375).
# tcp:// is the WSL deployment; unix:// is for running next to the daemon with its
# socket mounted (no WSL boot/keepalive).
# DOCKER_HOST=tcp://127.0.0.1:2375
# DOCKER_HOST=unix:///var/run/docker.sock

# Set to 0 to stop holding the WSL distro open while the server runs (tcp:// only)
# DOCKER_WSL_KEEPALIVE=1

# How long a running build may go silent before the stale sweep fails it (milliseconds)
# BUILD_STALE_TIMEOUT_MS=600000

# Folder with the built frontend (frontend/dist) to serve from this server's own
# origin. Empty (the default) serves no UI — in local dev the Vite dev server owns
# it. The app image (the repo root Dockerfile) sets it.
# STATIC_DIR=

# Hostnames (comma-separated, no ports) a request's Host header — and Origin, when
# a browser sends one — must name; anything else answers 403. Guards the login-less
# API against web pages reaching it through a browser on this machine. Add a name
# here when the platform is reached under another one.
# ALLOWED_HOSTS=localhost,127.0.0.1

# The AI assistant's model server (Ollama) and the model it runs on. The default
# URL is an Ollama installed natively (in WSL, reached through the localhost relay
# like the Docker daemon); docker-compose.yml points the platform at its own
# `ollama` service instead. The model must be pulled (`ollama pull <tag>`) and
# carry the `tools` capability. With Ollama down the server still starts — only
# the chat answers with an error.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Context window the model is loaded with, in tokens (Ollama's num_ctx)
# OLLAMA_NUM_CTX=8192
