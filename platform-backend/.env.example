# Copy to .env and adjust. All values are optional — the server falls back to the
# defaults shown here.

# Server bind address
PORT=3000
HOST=127.0.0.1

# Docker daemon endpoint, docker CLI style (defaults to tcp://127.0.0.1:2375).
# tcp:// is the WSL deployment; unix:// is for running next to the daemon with its
# socket mounted (no WSL boot/keepalive, and clearing container logs answers 409).
# DOCKER_HOST=tcp://127.0.0.1:2375
# DOCKER_HOST=unix:///var/run/docker.sock

# Set to 0 to stop holding the WSL distro open while the server runs (tcp:// only)
# DOCKER_WSL_KEEPALIVE=1

# How long a running build may go silent before the stale sweep fails it (milliseconds)
# BUILD_STALE_TIMEOUT_MS=600000
