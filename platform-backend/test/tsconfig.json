{
    // Typechecks the unit tests (and whatever they import from ../src) with the
    // backend's compiler options. A separate project like evals/: the main
    // tsconfig.json builds `src/` alone, so nothing here is ever emitted or shipped.
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": true
    },
    "include": ["./**/*.ts"]
}
